# Chimp — Phase 6A backend (Supabase). Copy to `.env.local` (already git-ignored) and fill in.
# These are PUBLIC client values (protected by Row Level Security).
# Never put a service_role / secret key in the app.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Phase 6D: sign-in is by email code; there are no test numbers or test flags any more.
# (If your .env.local still has EXPO_PUBLIC_ENABLE_TEST_AUTH, delete that line; nothing reads it.)
