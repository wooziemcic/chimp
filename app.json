{
  "expo": {
    "name": "Chimp",
    "slug": "chimp",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "chimp",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F5F7FB",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.aayushmallik.chimp",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.chimp.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F5F7FB",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Chimp uses your photos so you can set a profile picture."
        }
      ],
      "expo-video",
      [
        "expo-audio",
        {
          "microphonePermission": "Chimp uses the microphone only when you record a voice note in After Dark.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#1D6BFF"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b93fa463-208f-47ed-8919-a7c1a7817170"
      }
    }
  }
}
